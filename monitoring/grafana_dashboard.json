{
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "-- Grafana --"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Off",
  "editable": true,
  "elements": {
    "1": {
      "kind": "Panel",
      "spec": {
        "type": "row",
        "title": "🎵 Portify - Playlist Conversion Overview"
      }
    },
    "2": {
      "kind": "Panel",
      "spec": {
        "type": "stat",
        "title": "Successful Conversions",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(portify_conversions_total{environment=~\"^$environment$\", status=\"success\"}) or on() vector(0)",
            "legendFormat": "Successful Conversions",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "3": {
      "kind": "Panel",
      "spec": {
        "type": "stat",
        "title": "Failed Conversions",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(portify_conversions_total{environment=~\"^$environment$\", status=\"failed\"}) or on() vector(0)",
            "legendFormat": "Failed Conversions",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "4": {
      "kind": "Panel",
      "spec": {
        "type": "piechart",
        "title": "Conversion Success Rate",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "options": {
          "displayLabels": [
            "percent"
          ],
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showValues": true,
            "values": [
              "value"
            ]
          },
          "pieType": "donut",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(portify_conversions_total{environment=~\"^$environment$\"}) by (status)",
            "legendFormat": "{{status}}",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "5": {
      "kind": "Panel",
      "spec": {
        "type": "timeseries",
        "title": "Conversions Rate (5m average)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "short"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(rate(portify_conversions_total{environment=~\"^$environment$\"}[5m])) by (source, destination, status)",
            "legendFormat": "{{source}} \u2794 {{destination}} ({{status}})",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "6": {
      "kind": "Panel",
      "spec": {
        "type": "bargauge",
        "title": "Tracks Processed by Status",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "options": {
          "displayMode": "basic",
          "orientation": "horizontal",
          "showUnfilled": true,
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(portify_tracks_processed_total{environment=~\"^$environment$\"}) by (provider, status)",
            "legendFormat": "{{provider}} - {{status}}",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "7": {
      "kind": "Panel",
      "spec": {
        "type": "row",
        "title": "⚡ Outgoing API Performance & Latency"
      }
    },
    "8": {
      "kind": "Panel",
      "spec": {
        "type": "timeseries",
        "title": "95th Percentile API Latency",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "s"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "histogram_quantile(0.95, sum(rate(portify_api_latency_seconds_bucket{environment=~\"^$environment$\"}[5m])) by (le, provider, operation))",
            "legendFormat": "p95 {{provider}} ({{operation}})",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "9": {
      "kind": "Panel",
      "spec": {
        "type": "timeseries",
        "title": "API Request Rate by Operation & Status",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "reqps"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(rate(portify_api_requests_total{environment=~\"^$environment$\"}[5m])) by (provider, operation, status_code)",
            "legendFormat": "{{provider}} [{{operation}}] ({{status_code}})",
            "range": true,
            "refId": "A"
          }
        ]
      }
    },
    "10": {
      "kind": "Panel",
      "spec": {
        "type": "row",
        "title": "🛡️ Rate Limiting & Reliability"
      }
    },
    "11": {
      "kind": "Panel",
      "spec": {
        "type": "timeseries",
        "title": "API Request Retries (Rate-Limit Backoffs)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "short"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "sum(rate(portify_api_retries_total{environment=~\"^$environment$\"}[5m])) by (provider, operation, attempt, status_code)",
            "legendFormat": "{{provider}} [{{operation}}] (attempt {{attempt}}, code {{status_code}})",
            "range": true,
            "refId": "A"
          }
        ]
      }
    }
  },
