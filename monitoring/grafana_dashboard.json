    ],
    "fiscalYearStartMonth": 0,
    "from": "now-1h",
    "hideTimepicker": false,
    "timezone": "browser",
    "to": "now"
  },
  "title": "Portify Telemetry Dashboard",
  "variables": [
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "query": "label_values(environment)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 1
      }
    },
    {
      "kind": "DataSourceVariable",
      "spec": {
        "name": "DS_PROMETHEUS",
        "label": "Data Source",
        "type": "datasource",
        "pluginId": "prometheus",
        "multi": false,
        "includeAll": false
      }
    }
  ]
}
